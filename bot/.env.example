# Copy to .env (or fill in the same names under "Startup"/"Variables" in the panel).
# NOTE: this file with filled-in values must NEVER go into git or into Vanta. .env is in .gitignore.

# Discord Developer Portal -> your application -> Bot -> Reset Token   (SECRET)
DISCORD_BOT_TOKEN=
# Channel for the reports (Discord: Developer Mode on -> right-click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Your own Discord user id (right-click yourself -> Copy User ID); several: comma-separated
ADMIN_IDS=
# Optional but recommended: server id; slash commands then show up immediately in that server
DISCORD_GUILD_ID=

# Supabase -> Project Settings -> Data API (or "Connect"): Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> "secret" key (sb_secret_...), or the old service_role key.  (SECRET)
# This key bypasses all database security: only use it here, never in Vanta, never in git, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
POLL_SECONDS=15
DIGEST_WEEKDAY=0
DIGEST_HOUR=10
TIMEZONE=Europe/Amsterdam
LOG_LEVEL=INFO
