# Kopieer naar .env (of vul dezelfde namen in bij "Startup"/"Variables" in het paneel).
# LET OP: dit bestand met ingevulde waarden hoort NOOIT in git of in Vanta. .env staat in .gitignore.

# Discord Developer Portal -> jouw applicatie -> Bot -> Reset Token   (GEHEIM)
DISCORD_BOT_TOKEN=
# Kanaal voor de meldingen (Discord: Developer Mode aan -> rechtsklik op kanaal -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Jouw eigen Discord user id (rechtsklik op jezelf -> Copy User ID); meerdere: komma-gescheiden
ADMIN_IDS=
# Optioneel maar aangeraden: server id; slash commands verschijnen dan direct in die server
DISCORD_GUILD_ID=

# Supabase -> Project Settings -> Data API (of "Connect"): Project URL, bijv. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> "secret" key (sb_secret_...), of de oude service_role key.  (GEHEIM)
# Deze key omzeilt alle beveiliging in de database: alleen hier gebruiken, nooit in Vanta, nooit in git, nooit delen.
SUPABASE_SERVICE_ROLE_KEY=

# Optioneel
POLL_SECONDS=15
DIGEST_WEEKDAY=0
DIGEST_HOUR=10
TIMEZONE=Europe/Amsterdam
LOG_LEVEL=INFO
