# Kopieer naar .env (of vul dezelfde namen in bij "Startup"/"Variables" in het paneel).

# Discord Developer Portal -> jouw applicatie -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Kanaal voor de meldingen (Discord: Developer Mode aan -> rechtsklik op kanaal -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Jouw eigen Discord user id (rechtsklik op jezelf -> Copy User ID); meerdere: komma-gescheiden
ADMIN_IDS=
# Optioneel: server id; slash commands verschijnen dan direct in die server
DISCORD_GUILD_ID=

# De Worker (bijv. https://vanta-api.<jouw-subdomein>.workers.dev), zonder / op het eind
VANTA_API_URL=
# Precies dezelfde waarde als het BOT_API_SECRET van de Worker
BOT_API_SECRET=

# Optioneel
POLL_SECONDS=15
DIGEST_WEEKDAY=0
DIGEST_HOUR=10
TIMEZONE=Europe/Amsterdam
LOG_LEVEL=INFO
